# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work
go.work.sum

# env file
.env

dist/
bin/
node_modules/
# the binary "go build ./cmd/server" writes, not the cmd/server package
/server

# Beads: bead text lives in the Dolt tracker only, never in git
.beads/issues.jsonl
.beads/interactions.jsonl
.beads/events.jsonl

# release.yml copies the release checksums into the npm package at publish time
/checksums.txt
