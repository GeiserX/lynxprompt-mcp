# LynxPrompt API connection details
LYNXPROMPT_URL=https://lynxprompt.com
LYNXPROMPT_TOKEN=lp_xxxx

# Only register the read tools
# LYNXPROMPT_READ_ONLY=true

# Transport: empty (default = HTTP on 127.0.0.1:8080) or "stdio"
# TRANSPORT=stdio

# HTTP only: a non-loopback LISTEN_ADDR needs MCP_AUTH_TOKEN (32+ characters)
# LISTEN_ADDR=127.0.0.1:8080
# MCP_AUTH_TOKEN=
# Origins that pass the cross-origin check (403 otherwise). Not CORS: no preflight, no Access-Control-* headers.
# MCP_ALLOWED_ORIGINS=https://app.example.com
